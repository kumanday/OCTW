map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    server_name ${OCTW_SERVER_NAME};
    port_in_redirect off;
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${OCTW_SERVER_NAME};
    port_in_redirect off;

    ssl_certificate ${OCTW_SSL_CERT_FILE};
    ssl_certificate_key ${OCTW_SSL_KEY_FILE};
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;

    location ^~ /oauth2/ {
        proxy_pass http://octw-oidc:4180;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header X-Scheme https;
    }

    location = /oauth2/auth {
        internal;
        proxy_pass http://octw-oidc:4180/oauth2/auth;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header Content-Length "";
        proxy_pass_request_body off;
    }

    error_page 401 = @oauth2_signin;

    location @oauth2_signin {
        return 302 /oauth2/start?rd=$scheme://$http_host$request_uri;
    }

    location = /health {
        proxy_pass http://octw-api:8000/health;
    }

    location = / {
        return 302 /app;
    }

    location ^~ /app {
        auth_request /oauth2/auth;
        auth_request_set $user_email $upstream_http_x_auth_request_email;
        proxy_set_header X-Forwarded-Email $user_email;
        proxy_pass http://octw-api:8000;
    }

    location ^~ /api/v1/app/ {
        auth_request /oauth2/auth;
        auth_request_set $user_email $upstream_http_x_auth_request_email;
        proxy_set_header X-Forwarded-Email $user_email;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://octw-api:8000;
    }

    location /t/ {
        auth_request /oauth2/auth;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://octw-edge:8443;
    }

    location /oauth2/sign_out {
        proxy_pass http://octw-oidc:4180/oauth2/sign_out;
    }

    location ~ ^/[a-z0-9][a-z0-9-]*/? {
        auth_request /oauth2/auth;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://octw-edge:8443;
    }

    location / {
        return 404;
    }
}
