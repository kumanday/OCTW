# Core control-plane settings
OCTW_DB_URL=postgresql+asyncpg://octw:octw@octw-db:5432/octw
OCTW_REDIS_URL=redis://octw-cache:6379/0
OCTW_PUBLIC_BASE_URL=https://octw.example.com
OCTW_SERVER_NAME=octw.example.com
OCTW_EDGE_DOMAIN=octw.example.com
OCTW_API_INTERNAL_BASE_URL=http://octw-api:8000
OCTW_TRUSTED_PROXY_ENABLED=true
OCTW_TRUSTED_PROXY_USER_HEADER=X-Forwarded-Email
OCTW_TRUSTED_PROXY_IPS=172.30.0.0/24
OCTW_DEFAULT_PROVIDER=zai

# Secrets
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OCTW_JWT_SECRET=replace-with-strong-random-token
# Generate with: python3 -c "import os; print(os.urandom(32).hex())"
OCTW_KEK=replace-with-64-hex-character-kek

# Shared provider API keys (set at least one)
OCTW_ZAI_API_KEY=
OCTW_MOONSHOT_API_KEY=
OCTW_MINIMAX_API_KEY=

# oauth2-proxy base settings
# Valid providers include: oidc, keycloak-oidc, google
OCTW_OIDC_PROVIDER=oidc
# Config file under configs/oauth2-proxy/ used by the oauth2-proxy container.
OCTW_OIDC_CONFIG_FILE=oauth2-proxy.cfg
# Required for generic OIDC and keycloak-oidc. Leave blank for google.
OCTW_OIDC_ISSUER_URL=https://issuer.example.com/realms/octw
OCTW_OIDC_CLIENT_ID=octw
OCTW_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
OCTW_OIDC_COOKIE_SECRET=replace-with-base64-cookie-secret
# Restrict login to your workspace domain. Use * only for isolated test environments.
OCTW_OIDC_EMAIL_DOMAINS=example.com
# Allow oauth2-proxy redirects back to this host. Prefix subdomains with a dot.
OCTW_OIDC_WHITELIST_DOMAINS=.example.com

# Provider-specific examples live in:
#   configs/oauth2-proxy/keycloak.example.cfg
#   configs/oauth2-proxy/google-workspace.example.cfg
# For Google Workspace group checks, place the Admin SDK service account JSON at:
#   configs/oauth2-proxy/credentials/google-admin-sdk.json
